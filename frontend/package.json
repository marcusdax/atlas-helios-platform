    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "_proxyComment": [
    "The dev-server proxy lives in src/setupProxy.js, not here. A \"proxy\" field",
    "switches on react-scripts' dev-server host check, which derives its one",
    "allowed host from the machine's LAN address; where that address is outside",
    "the private ranges (containers, CI, many cloud VMs) it resolves to undefined",
    "and the dev server refuses to start. setupProxy.js forwards the same paths",
    "without engaging that check."
  ],
  "_jestComment": [
    "react-router-dom@7 re-exports from the subpath 'react-router/dom'. Webpack honours",
    "the package's exports map and resolves it; the jest-resolve bundled with",
    "react-scripts@5 predates exports maps, so any test that imports react-router-dom",
    "fails to even load the suite. Mapping the subpath to the file the exports map",
    "points at is the smallest fix that does not mean upgrading the whole toolchain -",
    "and the app build is unaffected either way."
  ],
  "jest": {
    "moduleNameMapper": {
      "^react-router/dom$": "react-router/dist/development/dom-export.js"
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
