# Backend configuration. Copy to `.env` and fill in what you need:
#
#     cp backend/.env.example backend/.env
#
# Nothing here is required for a development run — the server generates an
# ephemeral JWT secret and defaults to SQLite — but a production start refuses
# without JWT_SECRET.

# ---------------------------------------------------------------- required
# Token-signing secret. Generate with: openssl rand -hex 32
# Unset in development, a random one is generated per process and every
# session is dropped on restart. Unset in production, the server will not
# start, by design: it must never invent a signing key.
JWT_SECRET=

# Optional. Separate secret for refresh tokens; falls back to JWT_SECRET.
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=24h

# ---------------------------------------------------------------- database
# Defaults to Postgres. `sqlite3` runs against backend/dev.sqlite3 instead —
# the same engine the test suite uses. See frontend/README.md.
# DB_CLIENT=sqlite3
# DATABASE_URL=postgres://user:pass@localhost:5432/atlas

PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------- upstreams
# All optional. Each service reports its own absence rather than faking data.

# Identifies this client to api.weather.gov, which requires a User-Agent.
# NWS_USER_AGENT=atlas-helios-platform/1.0 (you@example.com)

# Lets a failed NOAA forecast call answer from the demo generator instead of
# 503. Off by default; the payload is stamped `source: 'mock'` either way, and
# weather *alerts* never fabricate.
# WEATHER_ALLOW_MOCK=true

# Nexus Mind bridge. Unset, /api/nexus/* answers 503 NEXUS_UNAVAILABLE.
# NEXUS_BRIDGE_URL=http://localhost:5051

# Real renders instead of synthetic placeholders.
# ALTER_RENDER_API_KEY=

# Property data providers. Unset, those lookups report unconfigured.
# CORELOGIC_API_KEY=
# BLACKKNIGHT_API_KEY=
# ZILLOW_API_KEY=
