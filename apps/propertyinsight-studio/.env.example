# PropertyInsight Studio

# --- Server ---
PORT=5175
NODE_ENV=development
# Number of proxy hops in front of this app. Leave 0 unless you actually run
# behind a proxy: trusting X-Forwarded-For when you don't lets callers spoof
# their IP past the rate limiter.
TRUST_PROXY_HOPS=0
MAX_BODY_SIZE=25mb
PUBLIC_BASE_URL=

# --- Rendering (@alter/render-*) ---
# Leave ALTER_RENDER_API_KEY empty to run fully offline: the mock provider
# returns real synthetic PNGs and the assist endpoints return a deterministic
# stub, so the whole app is demoable and testable before a key exists.
ALTER_RENDER_API_KEY=
ALTER_RENDER_PROVIDER=mock
ALTER_RENDER_PLAN_MODEL=gemini-2.5-flash
ALTER_RENDER_IMAGE_MODEL=gemini-2.5-flash-image
ALTER_RENDER_CONCURRENCY=4
ALTER_RENDER_CACHE_SIZE=100
ALTER_RENDER_CACHE_TTL_MS=86400000
ALTER_RENDER_MAX_BYTES=12582912
ALTER_RENDER_TIMEOUT_MS=90000
ALTER_RENDER_ATTEMPTS=3

# --- Assist (text features) ---
ALTER_ASSIST_MODEL=gemini-2.5-flash
ALTER_ASSIST_TIMEOUT_MS=45000

# --- Quotas (per window, per IP) ---
RATE_LIMIT_WINDOW_MS=900000
RENDER_RATE_LIMIT=40
ASSIST_RATE_LIMIT=200
