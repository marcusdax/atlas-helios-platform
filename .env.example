# Environment Configuration for Atlas & Helios PropertyInsight AI Platform

# Application
NODE_ENV=development
PORT=5000
APP_NAME=atlas-helios-platform
APP_VERSION=1.0.0

# Frontend
FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atlas_helios_dev
DB_USER=postgres
DB_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/atlas_helios_dev

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# External API Keys
NOAA_API_KEY=your-noaa-api-key-here
WEATHER_API_KEY=your-weather-api-key-here
CORELOGIC_API_KEY=your-corelogic-api-key-here
BLACKKNIGHT_API_KEY=your-blackknight-api-key-here
ZILLOW_API_KEY=your-zillow-api-key-here

# Computer Vision
CV_DAMAGE_MODEL_PATH=/models/damage-detection
CV_ROOF_MODEL_PATH=/models/roof-classification
CV_MATERIAL_MODEL_PATH=/models/material-detection
CV_SEVERITY_MODEL_PATH=/models/severity-assessment

# File Upload
MAX_FILE_SIZE=50mb
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf

# Email (for notifications and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@propertyinsight.ai

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# CORS
CORS_ORIGIN=http://localhost:3000

# Session
SESSION_SECRET=your-session-secret-change-in-production

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe (for payments if needed)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cloud Storage (AWS S3 or similar)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=atlas-helios-uploads

# Monitoring and Analytics
SENTRY_DSN=your-sentry-dsn-here
GOOGLE_ANALYTICS_ID=your-ga-id-here

# WebSocket
WS_CORS_ORIGIN=http://localhost:3000

# Feature Flags
ENABLE_COMPUTER_VISION=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# Development Tools
DEBUG=atlas-helios:*
NODEMON_PORT=5000

# Production Optimizations
CLUSTER_MODE=false
WORKER_PROCESSES=auto

# Security
BCRYPT_ROUNDS=12
COOKIE_SECRET=your-cookie-secret-change-in-production
CSRF_SECRET=your-csrf-secret-change-in-production

# Third-party Integrations
CRM_INTEGRATION_ENABLED=true
CRM_API_BASE_URL=https://api.crm-provider.com
CRM_API_KEY=your-crm-api-key

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Monitoring Regions (JSON)
MONITORING_REGIONS=[{"id":"dallas_metro","name":"Dallas Metro Area","center":{"lat":32.7767,"lng":-96.797},"radius":50,"bounds":{"north":33.2,"south":32.2,"east":-96.2,"west":-97.4}}]

# Health Check
HEALTH_CHECK_TIMEOUT=5000